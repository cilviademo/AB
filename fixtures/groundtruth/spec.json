    {
      "id": "drive",
      "name": "Drive",
      "type": "float",
      "min": 1.0,
      "max": 20.0,
      "default": 4.0,
      "units": "",
      "skew": 0.5
    },
    {
      "id": "oversample",
      "name": "Oversample",
      "type": "bool",
      "default": true
    },
    {
      "id": "outputGain",
      "name": "Output Gain",
      "type": "float",
      "min": -24.0,
      "max": 24.0,
