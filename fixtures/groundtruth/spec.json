  ],
  "state_only_fields": [
    {
      "id": "waveShapers_0_1",
      "note": "indexed decoy: serialized in the ValueTree but NOT an exported parameter (EXECUTE 2.2 gate)",
      "value": 0.25
    },
    {
      "id": "uiScale",
      "note": "UI_ONLY_CONTROL stored in state, never exported",
      "value": 1.0
    },
    {
      "id": "demoMode",
      "note": "LICENSING_AND_ENTITLEMENT_SUBSYSTEM state: 1 = demo (no valid serial), written by the processor from LicenseStub::isDemo()",
      "value": 1.0,
      "subsystem": "LICENSING_AND_ENTITLEMENT_SUBSYSTEM"
    },
    {
      "id": "serialChecksum",
      "note": "LICENSING_AND_ENTITLEMENT_SUBSYSTEM state: checksum LicenseStub computed for the last serial checked (ABGT-0000-0000-0000 \u2192 0x180)",
      "value": 384.0,
      "subsystem": "LICENSING_AND_ENTITLEMENT_SUBSYSTEM"
    }
  ],
  "dsp": {
    "filter": {
      "class": "abgt::TptLowpass",
      "kind": "TPT one-pole low-pass (Zavalishin), cutoff from 'cutoff'"
    },
    "waveshaper": {
      "class": "abgt::TanhShaper",
      "kind": "y = tanh(drive * x) / tanh(drive)",
      "params": [
        "drive",
        "mode"
      ]
    },
    "oversampling": {
      "class": "juce::dsp::Oversampling<float>",
      "factor": 2,
      "when": "oversample == true"
    },
    "signal_flow": [
      "inputGain",
      "TptLowpass",
      "TanhShaper (oversampled when enabled)",
      "outputGain"
    ],
    "mode_effect": "Clean: shaper bypassed \u00b7 Warm: tanh \u00b7 Hot: tanh with 2x drive"
  },
  "resources": [
