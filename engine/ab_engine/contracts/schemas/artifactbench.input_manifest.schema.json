{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "artifactbench.input_manifest",
  "description": "00_manifest/input_manifest.json — what was dropped, how it was grouped, and the interpretation tags usage_context / source_availability (SPEC rule 9, ADDENDUM C1; D-026).",
  "type": "object",
  "required": ["job_id", "usage_context", "source_availability", "interpretation", "primary", "inputs", "attachments", "ignored", "duplicates"],
  "properties": {
    "job_id": {"type": "string"},
    "name": {"type": "string"},
    "usage_context": {"type": "string", "enum": ["USER_RECOVERY", "KNOWN_SOURCE_FIXTURE", "BLACK_BOX_REFERENCE", "SOURCE_AVAILABLE_REFERENCE", "UNKNOWN_CONTEXT"]},
    "source_availability": {"type": "string", "enum": ["SOURCE_UNKNOWN", "SOURCE_UNAVAILABLE", "SOURCE_PARTIAL", "SOURCE_AVAILABLE", "KNOWN_SOURCE_GROUND_TRUTH"]},
    "interpretation": {"type": "string"},
    "legacy_ownership": {"type": "string", "description": "the retired --ownership word when a caller still passed one (alias only, D-026)"},
    "primary": {"type": "object", "required": ["path", "size", "sha256", "kind", "format_hint"]},
    "inputs": {"type": "array", "items": {"type": "object", "required": ["path", "size", "sha256", "kind"],
      "properties": {"kind": {"enum": ["binary", "pdb", "map", "obj", "source", "preset", "session", "asset", "archive", "other"]}}}},
    "attachments": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "ignored": {"type": "integer"},
    "duplicates": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
    "bundle_key": {"type": "string"},
    "source_roots": {"type": "array", "items": {"type": "string"}}
  }
}
